{
  "name": "@kandiforge/pptx-renderer",
  "version": "3.3.0",
  "description": "PPTX renderer for React with canvas-based slide rendering and filmstrip navigation",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "private": false,
  "license": "UNLICENSED",
  "author": "AbstractClass, Inc. <admin@abstractclass.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KentAls/pptx-renderer.git"
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "renderer",
    "canvas",
    "react",
    "slides",
    "presentation"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "NODE_ENV=test TS_NODE_PROJECT=tsconfig.test.json mocha --require tsx 'test/**/*.spec.ts'",
    "test:integration": "NODE_ENV=test TS_NODE_PROJECT=tsconfig.test.json mocha --require tsx 'test/integration/**/*.spec.ts'",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "canvas": "^2.11.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    }
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.14.0",
    "@xmldom/xmldom": "^0.8.11",
    "canvg": "^4.0.3",
    "cross-fetch": "^4.1.0",
    "jszip": "^3.10.1",
    "rtf.js": "^3.0.9",
    "wmf": "^1.0.2"
  },
  "devDependencies": {
    "@mui/icons-material": "^5.18.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "canvas": "^3.2.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "mocha": "^10.2.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "should": "^13.2.3",
    "tsc-alias": "^1.8.7",
    "tsx": "^4.7.0",
    "typescript": "^5.1.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
